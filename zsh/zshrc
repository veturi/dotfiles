# Resolve dotfiles repo location through the ~/.zshrc symlink
export DOTFILES="${${(%):-%x}:A:h:h}"

# oh-my-zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
COMPLETION_WAITING_DOTS="true"
plugins=(
   git
   colored-man-pages
   mix
   z
)
source $ZSH/oh-my-zsh.sh

# History
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt SHARE_HISTORY

# Preferred editor: neovim locally, vim on remote hosts
if [[ -n $SSH_CONNECTION ]] || ! command -v nvim >/dev/null; then
  export EDITOR='vim'
else
  export EDITOR='nvim'
  alias vim="nvim"
fi

export HOMEBREW_NO_ANALYTICS=1

# Disable autocomplete of hostnames for ssh command
zstyle ':completion:*:ssh:*' hosts off

# PATH
export PATH="$HOME/.local/bin:$HOME/go/bin:$PATH"
[[ -d "$HOME/.config/herd-lite/bin" ]] && export PATH="$HOME/.config/herd-lite/bin:$PATH"

# Version manager: mise if installed, otherwise asdf. Never both, their shims fight.
if command -v mise >/dev/null; then
  eval "$(mise activate zsh)"
elif [[ -d "${ASDF_DATA_DIR:-$HOME/.asdf}" ]]; then
  export PATH="${ASDF_DATA_DIR:-$HOME/.asdf}/shims:$PATH"
fi

# FZF
if command -v fzf >/dev/null; then
  source <(fzf --zsh)
  export FZF_DEFAULT_OPTS="--reverse --multi --height 50% -1 --inline-info --preview='[[ \$(file --mime {}) =~ binary ]] && echo {} is a binary file || (bat --style=numbers --color=always {} || cat {}) 2> /dev/null | head -300' --preview-window='right:hidden:wrap' --bind='f3:execute(bat --style=numbers {} || less -f {}),f2:toggle-preview,ctrl-d:half-page-down,ctrl-u:half-page-up,ctrl-a:select-all+accept,ctrl-y:execute-silent(echo {+} | pbcopy)'"
  export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
fi

# ELIXIR
# Enable shell history between IEX sessions
export ERL_AFLAGS="-kernel shell_history enabled"

# Aliases
alias excel="open -a Microsoft\ Excel"
alias gpom="git pull origin master"
alias gpuom="git push origin master"
alias yolo="claude --dangerously-skip-permissions"

# Machine specific stuff (not in git)
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
